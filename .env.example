# Lokal: `pnpm db:start` menjalankan Postgres lokal (prisma dev) di port ini.
DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"
# Direktori penyimpanan file upload (gambar produk, bukti transfer)
UPLOAD_DIR="./uploads"

# Alamat publik situs (sitemap, canonical, link share)
SITE_URL="http://localhost:3000"
